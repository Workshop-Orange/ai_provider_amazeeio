<?php

/**
 * @file
 * Hook implementations for the Amazee.io AI provider.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\ai_search\Plugin\search_api\backend\SearchApiAiSearchBackend;
use Drupal\Core\Session\AccountInterface;
use Drupal\user\UserInterface;
use Drupal\Core\TempStore\TempStoreException;
use Drupal\search_api\IndexInterface;

/**
 * Implements hook_search_api_index_update().
 *
 * When the search API index is updated, check the fields are correctly
 * setup in Postgres.
 */
function ai_provider_amazeeio_search_api_index_update(IndexInterface $index): void {
  $server = $index->getServerInstance();
  if (!($server->getBackend() instanceof SearchApiAiSearchBackend)) {
    return;
  }
  $backend_config = $server->getBackendConfig();
  if (!isset($backend_config['database'])) {
    return;
  }
  if ($backend_config['database'] !== 'amazeeio_vector_db') {
    return;
  }
  $ai_vdb_provider_postgres = \Drupal::service('ai.vdb_provider')->createInstance('amazeeio_vector_db');
  $connection = $ai_vdb_provider_postgres->getConnection($backend_config['database_settings']['database_name']);
  \Drupal::service('ai_vdb_provider_postgres.client')->updateFields(
    $index->getFields(),
    $backend_config['database_settings']['collection'],
    $connection,
  );
}

/**
 * Implements hook_ai_provider_info_alter().
 */
function ai_provider_amazeeio_ai_provider_info_alter(&$providers): void {
  // Remove the providers that this builds upon to simplify UI.
  unset($providers['openai']);
  unset($providers['litellm']);
}

/**
 * Implements hook_user_logout().
 */
function ai_provider_amazeeio_user_logout(AccountInterface $account): void {
  // Log the user out of Amazee during Drupal logout.
  _ai_provider_amazeeio_amazee_logout();
}

/**
 * Implements hook_user_login().
 */
function ai_provider_amazeeio_user_login(UserInterface $account): void {
  // Log the user out of Amazee during log in in case the last Drupal logout was
  // due to timeout/inactivity.
  _ai_provider_amazeeio_amazee_logout();
}

/**
 * Helper function to log user out of Amazee.io system.
 */
function _ai_provider_amazeeio_amazee_logout(): void {
  /** @var \Drupal\ai_provider_amazeeio\AmazeeIoApi\ClientInterface $amazee_client */
  $amazee_client = \Drupal::service('ai_provider_amazeeio.api_client');
  $amazee_client->logout();

  /** @var \Drupal\Core\TempStore\PrivateTempStoreFactory $temp_store */
  $temp_store = \Drupal::service('tempstore.private');
  try {
    $temp_store->get('amazeeio_ai')->delete('access_token');
  }
  catch (TempStoreException $e) {
    // Log error but do nothing as this shouldn't affect the user.
    \Drupal::logger('ai_provider_amazeeio')->error('Failed to log out of Amazee.io: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Implements hook_menu_links_discovered_alter().
 *
 * Alter descriptions of Open-AI provider menu links to not confuse users.
 */
function ai_provider_amazeeio_menu_links_discovered_alter(&$links) {
  $openai = $links['ai_provider_openai.settings_menu'];

  $links['ai_provider_litellm.settings_menu']['description'] = _ai_provider_amazeeio_inactive_description($links['ai_provider_litellm.settings_menu']['description']);
  $links['ai_provider_openai.settings_menu']['description'] = _ai_provider_amazeeio_inactive_description($links['ai_provider_openai.settings_menu']['description']);
}

/**
 * Adjust the description of inactive menu items.
 */
function _ai_provider_amazeeio_inactive_description(TranslatableMarkup $input) {
  return new TranslatableMarkup('@description<br/><em class="form-item__description"><strong>amazee.ai</strong> builds on this provider, but it is not used unless you explicitly configure it.</em>', ['@description' => $input]);
}
